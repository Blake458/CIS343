// Example Sloth program

SLOTH Animal {
    FUN speak() {
        PRINT "generic sound";
    }
}

SLOTH Dog : Animal {
    FUN speak() {
        PRINT "woof!";
    }
}

FUN main() {
    VAR d = NEW Dog();
    IF (d != NULL) {
        d.speak();
    } ELSE {
        PRINT "no dog!";
    }

    VAR count = 0;
    WHILE (count < 3) {
        PRINT count;
        count = count + 1;
    }

    FOR (VAR i = 0; i < 5; i = i + 1) {
        PRINT i;
    }

    GIVE TRUE;
}
